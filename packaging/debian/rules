#!/usr/bin/make -f

export CARGO_NET_OFFLINE = true

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --offline

override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/pathpilot

# Workspace and graphical tests run in CI, separately from binary packaging.
override_dh_auto_test:

# A vendored release source is an input; do not clean/rewrite its dependencies.
override_dh_auto_clean:

# dh_clean otherwise removes Cargo.toml.orig files covered by vendor checksums.
override_dh_clean:
	dh_clean -Xvendor/

# Cargo vendors are immutable inputs; no Autotools setup applies to this project.
override_dh_update_autotools_config:

override_dh_autoreconf:

override_dh_auto_configure:
